{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Linting edited file(s)...",
            "command": "node .codex/hooks/lint-edited-file.mjs",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/lint-edited-file.mjs')\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Running end-of-turn lint + typecheck...",
            "command": "node .codex/hooks/end-of-turn.mjs",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/end-of-turn.mjs')\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
