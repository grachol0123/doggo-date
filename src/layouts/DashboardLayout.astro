---
import Sidebar from "@/components/Sidebar.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<Layout title={title}>
  <div class="bg-cosmic min-h-screen w-full">
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col gap-4 p-4 md:flex-row md:gap-6 md:p-6">
      <Sidebar />
      <main class="flex-1">
        <slot />
      </main>
    </div>
  </div>
</Layout>
