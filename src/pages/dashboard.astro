---
import DashboardLayout from "@/layouts/DashboardLayout.astro";

const { user } = Astro.locals;
---

<DashboardLayout title="Dashboard">
  <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white shadow-2xl backdrop-blur-xl md:p-8">
    <p class="text-xs uppercase tracking-[0.3em] text-white/50">Panel właściciela</p>
    <h1 class="mt-3 text-3xl font-bold">Dashboard</h1>
    <p class="mt-4 text-white/80">
      Welcome, <span class="font-semibold text-white">{user?.email}</span>
    </p>
    <p class="mt-2 text-sm text-blue-100/70">This page is only for authenticated users.</p>
  </section>
</DashboardLayout>
