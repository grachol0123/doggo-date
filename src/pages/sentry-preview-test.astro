---
import Layout from "@/layouts/Layout.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<Layout title="Sentry lesson test">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center gap-6 p-8">
    <h1 class="text-3xl font-bold">Sentry lesson test</h1>
    <p>
      Each click deliberately reports one error to this deployment's Sentry environment. Production tests appear as
      production events and may trigger alerts.
    </p>
    <button
      id="sentry-browser-error"
      class="rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground"
      type="button"
    >
      Trigger test browser error
    </button>
    <div class="flex flex-wrap justify-center gap-4">
      <button class="rounded-md border px-5 py-3 font-semibold" data-server-mode="handled" type="button">
        Trigger handled server error
      </button>
      <button class="rounded-md border px-5 py-3 font-semibold" data-server-mode="uncaught" type="button">
        Trigger uncaught server error
      </button>
    </div>
    <p id="sentry-test-result" role="status" aria-live="polite"></p>
  </main>
</Layout>

<script>
  const result = document.querySelector<HTMLParagraphElement>("#sentry-test-result");

  document.querySelector<HTMLButtonElement>("#sentry-browser-error")?.addEventListener("click", () => {
    if (result) {
      result.textContent = "Triggering browser error. Verify the event and alert in Sentry.";
    }
    const error = new Error("Controlled Sentry lesson browser test");
    error.name = "SentryBrowserTestError";
    throw error;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-server-mode]").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!result) return;

      button.disabled = true;
      result.textContent = "Sending controlled server test...";
      try {
        const response = await fetch("/api/sentry-preview-test", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mode: button.dataset.serverMode }),
        });
        const expectedStatus = button.dataset.serverMode === "handled" ? 503 : 500;
        result.textContent =
          response.status === expectedStatus
            ? `Server test returned HTTP ${response.status}. Verify the event and alert in Sentry.`
            : `Unexpected HTTP ${response.status}; the test is not confirmed. Check login and the runtime flag.`;
      } catch (error) {
        console.error("Sentry lesson test request failed", error);
        result.textContent = "The server test request failed before returning a response.";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
