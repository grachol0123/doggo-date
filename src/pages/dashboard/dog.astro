---
import DogProfileForm from "@/components/dog/DogProfileForm";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { createClient } from "@/lib/supabase";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Alert, AlertDescription } from "@/components/ui/alert";
import type { Dog } from "@/types";

const DOG_PHOTOS_BUCKET = "dog-photos";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved") === "1";

let dog: Dog | null = null;
let existingPhotoUrl: string | null = null;
let pageError: string | null = null;

if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);

  if (supabase) {
    const { data, error: loadError } = await supabase.from("dogs").select("*").eq("owner_id", user.id).maybeSingle();
    if (loadError) {
      pageError = "Nie udało się wczytać profilu psa: " + loadError.message;
    } else {
      dog = data;
      if (dog?.photo_path) {
        existingPhotoUrl = supabase.storage.from(DOG_PHOTOS_BUCKET).getPublicUrl(dog.photo_path).data.publicUrl;
      }
    }
  } else {
    pageError = "Połączenie z bazą danych nie jest skonfigurowane.";
  }
}
---

<DashboardLayout title="Mój profil psa">
  <div class="flex min-h-full justify-center">
    <Card className="w-full max-w-3xl">
      <CardHeader>
        <CardTitle className="text-center text-2xl font-bold">Mój profil psa</CardTitle>
      </CardHeader>
      <CardContent>
        {pageError ? (
          <Alert variant="destructive" role="alert">
            <AlertDescription>{pageError}</AlertDescription>
          </Alert>
        ) : (
          <>
            {saved && !error && (
              <Alert role="status" className="border-success/30 bg-success/10 mb-4">
                <AlertDescription className="text-success">Profil psa został zapisany.</AlertDescription>
              </Alert>
            )}
            <DogProfileForm dog={dog} existingPhotoUrl={existingPhotoUrl} serverError={error} client:load />
          </>
        )}
        <p class="text-muted-foreground mt-4 text-center text-sm">
          <a href="/dashboard" class="text-primary hover:underline">
            Powrót do panelu
          </a>
        </p>
      </CardContent>
    </Card>
  </div>
</DashboardLayout>
