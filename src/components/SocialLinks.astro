---
/**
 * Row of social media icon links for the homepage hero. Hrefs are placeholders
 * until real brand profiles exist.
 */
interface SocialLink {
  href: string;
  label: string;
}

const links: SocialLink[] = [
  { href: "#", label: "Facebook" },
  { href: "#", label: "Twitter" },
  { href: "#", label: "Instagram" },
  { href: "#", label: "YouTube" },
];
---

<div class="flex gap-4">
  {links.map((link) => (
    <a
      href={link.href}
      aria-label={link.label}
      class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-white/80 transition-colors hover:border-white/40 hover:bg-white/10 hover:text-white"
    >
      {link.label === "Facebook" && (
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M13.5 9h1.5V7h-1.9c-1.4 0-2.1.9-2.1 2.1V11H9.5v2H11v5h2v-5h1.8l.3-2H13v-1.4c0-.4.2-.6.5-.6z" />
        </svg>
      )}
      {link.label === "Twitter" && (
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M8 8l8 8M16 8l-8 8" stroke-linecap="round" />
        </svg>
      )}
      {link.label === "Instagram" && (
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <rect x="4" y="4" width="16" height="16" rx="4" />
          <circle cx="12" cy="12" r="3.2" />
          <circle cx="16.3" cy="7.7" r="0.6" fill="currentColor" stroke="none" />
        </svg>
      )}
      {link.label === "YouTube" && (
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <rect x="3" y="6" width="18" height="12" rx="3" />
          <path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none" />
        </svg>
      )}
    </a>
  ))}
</div>
