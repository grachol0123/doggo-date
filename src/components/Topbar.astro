---
const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  {user ? (
    <>
      <span class="text-amber-100/70">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-rose-300 transition-colors hover:text-rose-100 hover:underline">
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-rose-300 transition-colors hover:text-rose-100 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-amber-100/70">New to Doggo Date?</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-rose-300 transition-colors hover:text-rose-100 hover:underline">
          Log in
        </a>
        <a href="/auth/signup" class="text-rose-300 transition-colors hover:text-rose-100 hover:underline">
          Join for free
        </a>
      </div>
    </>
  )}
</div>
